# Copy to .env and fill in. Never commit .env.
POSTGRES_USER=cards
POSTGRES_PASSWORD=cards
POSTGRES_DB=cards
DATABASE_URL=postgresql+psycopg://cards:cards@db:5432/cards
# Host port for the database when you run the backend outside Docker.
DB_HOST_PORT=5433

LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5-5
# Effort is sent only to the Claude 5 models; leave it empty for a model that does not take it.
LLM_EFFORT=low
ANTHROPIC_API_KEY=
# For a gateway that speaks the Anthropic API: its address, and its token if it takes a
# bearer token instead of an API key. Set LLM_MODEL to a model name the gateway offers.
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=

# Outgoing email for account verification. docker compose uses its local Mailpit inbox
# (http://localhost:8025) unless you set a real SMTP server here.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_STARTTLS=true
# MAIL_FROM=Sentence Cards <no-reply@example.com>
# APP_URL=http://localhost:5173
